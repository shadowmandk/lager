# Produktion på lager.itxpartner.dk (VPS hos hosting.gl). Kopiér til .env på serveren og udfyld de tomme felter.
# Hemmeligheder skrives kun her på serveren, aldrig i git, mails eller chat.

APP_NAME=Lagerstyring
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lager.itxpartner.dk

APP_LOCALE=da
APP_FALLBACK_LOCALE=da
APP_FAKER_LOCALE=da_DK

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# En logfil pr. dag, de seneste 14 gemmes. Kun advarsler og fejl.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL på samme server. setup-server.sh opretter databasen og skriver linjerne til
# /home/lager/.lager-db; kopiér dem herind (cat ~/.lager-db).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lager
DB_USERNAME=lager
DB_PASSWORD=
DB_COLLATION=utf8mb4_danish_ci

# Sessionen holder i 30 dage, men låseskærmen låser efter 30 minutter uden aktivitet.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Første admin. Fjern ADMIN_PASSWORD igen, når "php artisan db:seed" har kørt.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Første kode til låseskærmen (6 cifre). Fjern den igen efter seed; skift den under Opsætning.
ACCESS_CODE=

# POC: start med fiktive kunder og containere. Sæt til false inden rigtig drift.
SEED_DEMO=true

# Microbizz. Tomme felter = integrationen er slået fra.
MICROBIZZ_CONTRACT=
MICROBIZZ_APIKEY=
MICROBIZZ_USERNAME=
MICROBIZZ_PASSWORD=
